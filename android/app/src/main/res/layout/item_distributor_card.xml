<?xml version="1.0" encoding="utf-8"?>
<!-- HU-023: Tarjeta de distribuidor con sello de verificación prominente -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="176dp"
    android:layout_height="90dp"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_distributor_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="AgroMaya"
                android:textColor="@color/gray_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!--
                HU-023: Sello "Verificado" siempre visible en la lista
                de distribuidores verificados. Color verde con checkmark.
            -->
            <TextView
                android:id="@+id/tv_verified_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="@drawable/bg_verified_badge"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="✓ Verificado"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Quiché"
            android:textColor="@color/gray_mid"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="★ 4.8"
                android:textColor="@color/orange_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_directions"
                android:tint="@color/gray_mid" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
