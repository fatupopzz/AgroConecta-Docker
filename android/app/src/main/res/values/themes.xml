<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AgroConecta" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_primary_dark</item>
        <item name="colorAccent">@color/orange_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/green_primary_dark</item>
    </style>

    <style name="Theme.AgroConecta.Splash" parent="Theme.AgroConecta">
        <item name="android:windowBackground">@color/green_primary</item>
    </style>

    <!-- Chip styles -->
    <style name="Widget.AgroConecta.Chip.Selected" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Widget.AgroConecta.Chip.Unselected" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/gray_light</item>
        <item name="android:textColor">@color/gray_dark</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- Button primary -->
    <style name="Widget.AgroConecta.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button outlined -->
    <style name="Widget.AgroConecta.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/green_primary</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
