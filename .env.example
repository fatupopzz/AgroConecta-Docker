# Copia este archivo como .env y reemplaza el valor antes de iniciar Docker.
# Nunca reutilices este marcador en un ambiente real.
JWT_SECRET=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_64_BYTES
RECURRING_ORDERS_INTERVAL_MS=60000
CACHE_TTL_SECONDS=300

# Para ejecutar el backend fuera de Docker con un Redis local.
# Docker Compose usa automaticamente redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Firebase Cloud Messaging. Convierte el JSON de la cuenta de
# servicio a Base64 y guarda únicamente el valor resultante en el .env local.
FIREBASE_PROJECT_ID=REEMPLAZAR_CON_EL_ID_DEL_PROYECTO_FIREBASE
FIREBASE_SERVICE_ACCOUNT_BASE64=REEMPLAZAR_CON_EL_JSON_BASE64_DE_LA_CUENTA_DE_SERVICIO

# HTTPS en la VM (Caddy). Déjalos comentados en desarrollo local.
# COMPOSE_PROFILES=https activa el servicio caddy en docker-compose.yml.
# AGROCONECTA_DOMAIN es el nombre DNS que apunta a la IP pública de la VM.
# ACME_EMAIL es obligatorio para Caddy: Let's Encrypt avisa ahí si un
# certificado está por vencer y habilita ZeroSSL como respaldo.
# COMPOSE_PROFILES=https
# AGROCONECTA_DOMAIN=REEMPLAZAR_CON_EL_DOMINIO_DE_LA_VM
# ACME_EMAIL=REEMPLAZAR_CON_UN_CORREO_DEL_EQUIPO
